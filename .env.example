# Copy to .env and fill in. .env is gitignored.

# Where the SQLite database and uploaded meal photos live
DATA_DIR=./var
DATABASE_FILE=./var/app.db

# HTTP server
PORT=8787

# Snap photo logging (Module 4). The key stays on the server, never sent to the browser.
# VISION_PROVIDER: anthropic | openai | gemini | openai_compatible
VISION_PROVIDER=anthropic
VISION_API_KEY=
VISION_MODEL=
# Only for openai_compatible (e.g. a local Ollama / vLLM endpoint)
VISION_BASE_URL=
