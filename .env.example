# Copy to .env and fill in. .env is gitignored.

# Where the SQLite database and uploaded meal photos live
DATA_DIR=./var
DATABASE_FILE=./var/app.db

# HTTP server
PORT=8787

# ── Snap photo logging ─────────────────────────────────────────────────────────────────────
# The key stays on the server and is never sent to the browser.
# VISION_PROVIDER: anthropic | openai | gemini | openai_compatible | mock
#   anthropic          Claude (default model claude-opus-5-5). VISION_API_KEY, or ANTHROPIC_API_KEY.
#   openai             VISION_API_KEY and VISION_MODEL required.
#   gemini             VISION_API_KEY and VISION_MODEL required.
#   openai_compatible  Any OpenAI-style server (Ollama, vLLM, LM Studio): VISION_BASE_URL and VISION_MODEL.
#                      e.g. VISION_BASE_URL=http://localhost:11434/v1  VISION_MODEL=<a vision model you have pulled>
#   mock               No key; returns the same sample thali for every photo (for trying the flow).
VISION_PROVIDER=anthropic
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=
# anthropic only: low | medium | high | xhigh | max (default medium)
VISION_EFFORT=
